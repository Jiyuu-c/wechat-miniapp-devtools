{
  "mcpServers": {
    "wechat-project-a": {
      "command": "node",
      "args": ["<REPOSITORY_PATH>/scripts/run-mcp.js"],
      "env": {
        "MINIAPP_PROJECT_PATH": "D:/path/to/project-a",
        "WECHAT_DEVTOOLS_CLI_PATH": "D:/path/to/wechat/cli.bat",
        "WECHAT_HTTP_PORT": "37733",
        "WECHAT_AUTOMATION_PORT": "9420"
      }
    },
    "wechat-project-b": {
      "command": "node",
      "args": ["<REPOSITORY_PATH>/scripts/run-mcp.js"],
      "env": {
        "MINIAPP_PROJECT_PATH": "D:/path/to/project-b",
        "WECHAT_DEVTOOLS_CLI_PATH": "D:/path/to/wechat/cli.bat",
        "WECHAT_HTTP_PORT": "37734",
        "WECHAT_AUTOMATION_PORT": "9421"
      }
    }
  }
}
